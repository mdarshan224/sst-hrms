# Placeholders only. Configure real values as server-side runtime variables.
FAST2SMS_API_KEY=replace_with_server_secret
FAST2SMS_OTP_ID=your_smartotp_template_id
PLATFORM_ADMIN_MOBILE=your_10_digit_indian_mobile
# Optional one-time migration of previous platform-owner memberships only.
PLATFORM_OWNER_EMAIL=previous_owner@example.com
# Future PostgreSQL/Prisma deployment (not used by this D1 application):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/hrms
# Future integrations, not yet implemented:
# MAIL_PROVIDER_API_KEY=replace_me
# PRIVATE_STORAGE_ENDPOINT=https://storage.example.com
# PRIVATE_STORAGE_ACCESS_KEY=replace_me
# PRIVATE_STORAGE_SECRET_KEY=replace_me
# DOCUMENT_ENCRYPTION_KEY=replace_me
# QUEUE_URL=replace_me
# PAYMENT_PROVIDER_SECRET=replace_me
# PAYMENT_WEBHOOK_SECRET=replace_me
# D1 binding DB is provisioned through .openai/hosting.json.

# Optional managed customer-domain synchronization, implemented in Milestone 06.
# Set an independent high-entropy HRMS secret in hosting and the operator's secure environment.
# HRMS_DOMAIN_SYNC_SECRET=configure_securely_do_not_reuse_ERP_DOMAIN_PROXY_SECRET

# Milestone 07: server-only authenticated hosting retrieval. Native Sites IDs are
# NOT Cloudflare IDs. Leave unset until the actual managed provider permits access.
# HRMS_DOMAIN_CF_READ_TOKEN=operator_read_only_token
# HRMS_DOMAIN_CF_ZONE_ID=actual_zone_identifier
# HRMS_DEPLOYMENT_VERSION=actual_saved_deployment_version_id

# Cashfree Secure ID VRS credentials, not Cashfree Payments/Payout credentials.
# Configure each environment separately; the application never switches implicitly.
# CASHFREE_SECUREID_SANDBOX_CLIENT_ID=configure_as_server_secret
# CASHFREE_SECUREID_SANDBOX_CLIENT_SECRET=configure_as_server_secret
# CASHFREE_SECUREID_SANDBOX_PUBLIC_KEY=registered_spki_pem_public_key
# CASHFREE_SECUREID_PRODUCTION_CLIENT_ID=configure_as_server_secret
# CASHFREE_SECUREID_PRODUCTION_CLIENT_SECRET=configure_as_server_secret
# CASHFREE_SECUREID_PRODUCTION_PUBLIC_KEY=registered_spki_pem_public_key
# CASHFREE_SECUREID_PRODUCTION_APPROVED=true_only_after_operator_account_review
# DOCUMENT_SCAN_CALLBACK_SECRET=independent_approved_scanner_secret_min_32_chars
# BUCKET is a private R2 binding provisioned by hosting, not a frontend URL.

# Milestone08: server-only32-byte AES key,64 lowercase hex; never rotate blindly.
# ONBOARDING_DATA_KEY=configure_server_secret_only
# HRMS_JOB_RUNNER_SECRET=independent_high_entropy_server_secret
# DOCUMENT_SCANNER_URL=https://approved-hrms-scanner.example/scan
# DOCUMENT_SCANNER_TOKEN=independent_private_gateway_bearer_secret
# DOCUMENT_SCAN_CALLBACK_SECRET=shared_scan_hmac_secret_min_32_chars
# Product account entitlements must be independently validated.
# CASHFREE_SECUREID_SANDBOX_PRODUCTS=digilocker
# CASHFREE_SECUREID_PRODUCTION_PRODUCTS=digilocker
# CASHFREE_DIGILOCKER_PRODUCTION_HOSTNAME=exact_provider_host_verified_by_operator
